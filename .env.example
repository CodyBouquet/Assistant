# ---- Core ----
DATABASE_URL="postgresql://user:password@host:5432/assistant?sslmode=require"
AUTH_SECRET="generate: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# ---- Encryption for Plaid access tokens at rest ----
# Must be 32 raw bytes, base64-encoded. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# ---- Sign-in allow-list (comma-separated, lowercase) ----
# Only these emails can sign in or create an account.
ALLOWED_EMAILS="you@example.com"

# ---- Email magic link (Auth.js) ----
EMAIL_SERVER_HOST="smtp.resend.com"
EMAIL_SERVER_PORT="465"
EMAIL_SERVER_USER="resend"
EMAIL_SERVER_PASSWORD="re_your_resend_api_key"
EMAIL_FROM="assistant@yourdomain.com"

# ---- Anthropic ----
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-opus-4-7"

# ---- Plaid (Development tier, free up to 100 Items) ----
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="development"
PLAID_PRODUCTS="transactions,accounts"
PLAID_COUNTRY_CODES="US"
PLAID_REDIRECT_URI=""

# ---- Twilio ----
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
# Your personal number Twilio will text (E.164, e.g. +13125551234)
OWNER_PHONE_NUMBER=""

# ---- Cron ----
# generate: openssl rand -hex 32
CRON_SECRET=""

# ---- App ----
APP_URL="http://localhost:3000"
